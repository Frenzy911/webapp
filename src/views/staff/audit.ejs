<section class="page-head">
  <h1>Audit log</h1>
  <p class="lead">Who did what, and when. Newest first (last 300 entries).</p>
</section>

<form method="get" action="/staff/audit" class="search-bar">
  <label for="audit-event" class="sr-only">Event</label>
  <select id="audit-event" name="event">
    <option value="">All events</option>
    <% events.forEach((e) => { %><option value="<%= e.id %>"<%= eventId === e.id ? ' selected' : '' %>><%= e.title %></option><% }) %>
  </select>
  <label for="audit-action" class="sr-only">Action</label>
  <select id="audit-action" name="action">
    <option value="">All actions</option>
    <% Object.entries(actions).forEach(([k, label]) => { %><option value="<%= k %>"<%= action === k ? ' selected' : '' %>><%= label %></option><% }) %>
  </select>
  <button class="btn" type="submit">Filter</button>
</form>

<div class="table-wrap card">
  <table class="table">
    <thead><tr><th scope="col">When</th><th scope="col">Who</th><th scope="col">What</th><th scope="col">Details</th><th scope="col">Event</th></tr></thead>
    <tbody>
      <% if (!rows.length) { %><tr><td colspan="5" class="muted">Nothing logged yet.</td></tr><% } %>
      <% rows.forEach((r) => { %>
        <tr>
          <td class="nowrap"><%= fmt.formatDateTime(r.created_at) %></td>
          <td><%= r.actor %></td>
          <td><span class="badge badge-<%= r.action === 'checkin_undone' || r.action === 'registration_cancelled' ? 'warning' : 'muted' %>"><%= actions[r.action] || r.action %></span></td>
          <td><%= r.details %></td>
          <td><%= r.event_title || '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
