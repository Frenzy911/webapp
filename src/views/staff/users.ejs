<section class="page-head">
  <h1>Staff accounts</h1>
  <p class="lead"><strong>Organizers</strong> manage events, attendees and staff. <strong>Door staff</strong> can only use the check-in screen.</p>
</section>

<div class="table-wrap card">
  <table class="table">
    <thead><tr><th scope="col">Name</th><th scope="col">Username</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
    <tbody>
      <% users.forEach((u) => { %>
        <tr>
          <td><strong><%= u.name %></strong><%= u.id === currentStaff.id ? ' (you)' : '' %></td>
          <td class="mono">@<%= u.username %></td>
          <td><%= u.role === 'organizer' ? 'Organizer' : 'Door staff' %></td>
          <td><span class="badge badge-<%= u.active ? 'success' : 'muted' %>"><%= u.active ? 'Active' : 'Deactivated' %></span></td>
          <td class="actions-cell">
            <% if (u.id !== currentStaff.id) { %>
              <form method="post" action="/staff/users/<%= u.id %>/active" class="inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="active" value="<%= u.active ? '0' : '1' %>">
                <button class="btn btn-small btn-ghost" type="submit"><%= u.active ? 'Deactivate' : 'Reactivate' %></button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="card form-card wide">
  <h2>Add a staff account</h2>
  <form method="post" action="/staff/users" class="stack" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="grid-2">
      <%- include('../partials/field', { name: 'name', label: 'Name', value: values.name }) %>
      <%- include('../partials/field', { name: 'username', label: 'Username', value: values.username, extra: 'autocapitalize="none" spellcheck="false"' }) %>
    </div>
    <div class="grid-2">
      <%- include('../partials/field', { name: 'password', label: 'Password', type: 'password', value: '', autocomplete: 'new-password', hint: 'At least 8 characters. Stored as a bcrypt hash.' }) %>
      <%- include('../partials/field', { name: 'role', label: 'Role', type: 'select', value: values.role, options: [['door', 'Door staff (check-in only)'], ['organizer', 'Organizer']] }) %>
    </div>
    <div class="form-actions"><button class="btn btn-primary" type="submit">Create account</button></div>
  </form>
</div>
