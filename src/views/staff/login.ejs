<div class="card form-card narrow">
  <p class="eyebrow">Staff only</p>
  <h1>Sign in</h1>
  <% if (next) { %><p class="muted">Please sign in to continue.</p><% } %>
  <% if (error) { %><div class="notice notice-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/staff/login" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <%- include('../partials/field', { name: 'username', label: 'Username', value: username, autocomplete: 'username', extra: 'autocapitalize="none" spellcheck="false" required', errors: {} }) %>
    <%- include('../partials/field', { name: 'password', label: 'Password', type: 'password', value: '', autocomplete: 'current-password', extra: 'required', errors: {} }) %>
    <button class="btn btn-primary btn-big" type="submit">Sign in</button>
  </form>
</div>
