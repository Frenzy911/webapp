<section class="page-head page-head-row">
  <div>
    <h1>Dashboard</h1>
    <p class="lead">Every event that hasn't ended yet.</p>
  </div>
  <a class="btn btn-primary" href="/staff/events/new">+ New event</a>
</section>

<% if (!events.length) { %>
  <div class="card empty-state"><p>No upcoming events. <a href="/staff/events/new">Create one</a>.</p></div>
<% } %>

<div class="dash-grid">
  <% events.forEach((ev) => { %>
    <article class="card dash-card">
      <header class="dash-card-head">
        <div>
          <h2><a href="/staff/events/<%= ev.id %>/attendees"><%= ev.title %></a></h2>
          <p class="meta"><%= ev.dateLabel %> · <%= ev.timeLabel %></p>
        </div>
        <span class="badge badge-<%= ev.status === 'published' ? 'success' : ev.status === 'draft' ? 'muted' : 'warning' %>"><%= statusLabel(ev.status) %></span>
      </header>
      <dl class="stat-grid">
        <div><dt>Capacity</dt><dd><%= ev.capacity %></dd></div>
        <div><dt>Confirmed</dt><dd><%= ev.registered %></dd><span class="stat-help">incl. checked in</span></div>
        <div><dt>Waitlisted</dt><dd><%= ev.waitlisted %></dd></div>
        <div><dt>Cancelled</dt><dd><%= ev.cancelled %></dd></div>
        <div><dt>Checked in</dt><dd><%= ev.checked_in %></dd></div>
        <div><dt>No-shows</dt><dd><%= ev.noShows === null ? '—' : ev.noShows %></dd><span class="stat-help"><%= ev.noShows === null ? 'after it starts' : 'not checked in' %></span></div>
      </dl>
      <footer class="dash-card-actions">
        <a class="btn btn-small" href="/staff/events/<%= ev.id %>/attendees">Attendees</a>
        <% if (ev.status !== 'draft') { %><a class="btn btn-small" href="/staff/events/<%= ev.id %>/checkin">Check-in</a><% } %>
        <a class="btn btn-small btn-ghost" href="/staff/events/<%= ev.id %>/attendees.csv">Export CSV</a>
      </footer>
    </article>
  <% }) %>
</div>
