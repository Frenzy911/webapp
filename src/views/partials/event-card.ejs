<%
  const months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
%>
<a class="event-card<%= ev.hasEnded ? ' is-ended' : '' %>" href="/events/<%= ev.id %>">
  <div class="date-badge" aria-hidden="true">
    <span class="date-badge-m"><%= months[Number(ev.starts_at.slice(5, 7)) - 1] %></span>
    <span class="date-badge-d"><%= Number(ev.starts_at.slice(8, 10)) %></span>
  </div>
  <div class="event-card-body">
    <h3 class="event-card-title"><%= ev.title %></h3>
    <p class="meta"><%= ev.dateLabel %> · <%= ev.timeLabel %></p>
    <p class="meta"><%= ev.venue %></p>
    <p class="event-card-tags">
      <% if (ev.hasEnded) { %>
        <span class="badge badge-muted">Ended</span>
      <% } else { %>
        <% if (ev.hasStarted) { %><span class="badge badge-info">Happening now</span><% } %>
        <% if (ev.isFull) { %>
          <span class="badge badge-danger">Full</span>
          <span class="spots"><%= ev.waitlisted %> on waitlist</span>
        <% } else { %>
          <span class="spots<%= ev.spotsLeft <= 5 ? ' spots-low' : '' %>"><strong><%= ev.spotsLeft %></strong> of <%= ev.capacity %> spots left</span>
        <% } %>
      <% } %>
    </p>
  </div>
</a>
