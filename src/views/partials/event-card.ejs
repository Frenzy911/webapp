<%
  const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
  const month = months[Number(ev.starts_at.slice(5, 7)) - 1];
  const day = Number(ev.starts_at.slice(8, 10));
%>
<a class="event-card<%= ev.hasEnded ? ' is-ended' : '' %>" href="/events/<%= ev.id %>" aria-labelledby="event-<%= ev.id %>-title">
  <div class="event-card-top">
    <div class="date-badge" aria-hidden="true">
      <span class="date-badge-m"><%= month %></span>
      <span class="date-badge-d"><%= day %></span>
    </div>
    <div class="event-card-tags">
      <% if (ev.hasEnded) { %>
        <span class="badge badge-muted">Ended</span>
      <% } else { %>
        <% if (ev.hasStarted) { %><span class="badge badge-success badge-live">Happening now</span><% } %>
        <% if (ev.isFull) { %><span class="badge badge-warning">Full</span><% } %>
      <% } %>
    </div>
  </div>
  <div class="event-card-body">
    <h3 class="event-card-title" id="event-<%= ev.id %>-title"><%= ev.title %></h3>
    <p class="event-meta"><svg class="icon" aria-hidden="true"><use href="#icon-calendar"/></svg><span><%= ev.dateLabel %> · <%= ev.timeLabel %></span></p>
    <p class="event-meta"><svg class="icon" aria-hidden="true"><use href="#icon-pin"/></svg><span><%= ev.venue %></span></p>
  </div>
  <div class="event-card-footer">
    <% if (!ev.hasEnded) { %>
      <span class="spots<%= !ev.isFull && ev.spotsLeft <= 5 ? ' spots-low' : '' %>">
        <svg class="icon" aria-hidden="true"><use href="#icon-ticket"/></svg>
        <% if (ev.isFull) { %><span><%= ev.waitlisted %> on waitlist</span>
        <% } else { %><span><strong><%= ev.spotsLeft %></strong> of <%= ev.capacity %> spots left</span><% } %>
      </span>
    <% } %>
    <span class="event-card-arrow" aria-hidden="true"><svg class="icon"><use href="#icon-arrow"/></svg></span>
  </div>
</a>
