<%
  const id = `f-${name}`;
  const err = (locals.errors || {})[name];
  const hintId = locals.hint ? `${id}-hint` : '';
  const errId = err ? `${id}-error` : '';
  const describedBy = [hintId, errId].filter(Boolean).join(' ');
%>
<div class="field<%= err ? ' has-error' : '' %>">
  <label for="<%= id %>"><%= label %></label>
  <% if (locals.hint) { %><p class="hint" id="<%= hintId %>"><%= hint %></p><% } %>
  <% if (locals.type === 'textarea') { %>
    <textarea id="<%= id %>" name="<%= name %>" rows="<%= locals.rows || 5 %>"<%- describedBy ? ` aria-describedby="${describedBy}"` : '' %><%- err ? ' aria-invalid="true"' : '' %>><%= value %></textarea>
  <% } else if (locals.type === 'select') { %>
    <select id="<%= id %>" name="<%= name %>"<%- describedBy ? ` aria-describedby="${describedBy}"` : '' %><%- err ? ' aria-invalid="true"' : '' %>>
      <% options.forEach(([v, l]) => { %><option value="<%= v %>"<%= String(value) === String(v) ? ' selected' : '' %>><%= l %></option><% }) %>
    </select>
  <% } else { %>
    <input id="<%= id %>" name="<%= name %>" type="<%= locals.type || 'text' %>" value="<%= value %>"
      <% if (locals.autocomplete) { %>autocomplete="<%= autocomplete %>"<% } %>
      <% if (locals.inputmode) { %>inputmode="<%= inputmode %>"<% } %>
      <% if (locals.placeholder) { %>placeholder="<%= placeholder %>"<% } %>
      <% if (locals.maxlength) { %>maxlength="<%= maxlength %>"<% } %>
      <% if (locals.min !== undefined) { %>min="<%= min %>"<% } %>
      <% if (locals.extra) { %><%- extra %><% } %>
      <%- describedBy ? `aria-describedby="${describedBy}"` : '' %><%- err ? ' aria-invalid="true"' : '' %>>
  <% } %>
  <% if (err) { %><p class="field-error" id="<%= errId %>"><span aria-hidden="true">⚠ </span><%= err %></p><% } %>
</div>
