<div class="public-flow">
  <a class="back-link" href="/events/<%= ev.id %>">← Back to event</a>

  <div class="card form-card">
    <p class="eyebrow"><%= waitlist ? 'Join the waitlist' : 'Register' %></p>
    <h1><%= ev.title %></h1>
    <p class="meta"><%= ev.dateLabel %> · <%= ev.timeLabel %><br><%= ev.venue %></p>

    <% if (waitlist) { %>
      <div class="notice notice-warning">
        <strong>This event is full.</strong> Join the waitlist and you'll get a place in line. You are <strong>not confirmed</strong> until a spot opens and staff move you up. We'll email you when that happens.
      </div>
    <% } %>

    <% if (formError) { %>
      <div class="notice notice-error" role="alert">
        <%= formError %>
        <% if (duplicate) { %> <a href="/tickets/find">Find my ticket →</a><% } %>
      </div>
    <% } else if (Object.keys(errors).length) { %>
      <div class="notice notice-error" role="alert">Please fix the <%= Object.keys(errors).length === 1 ? 'field' : `${Object.keys(errors).length} fields` %> marked below.</div>
    <% } %>

    <form method="post" action="/events/<%= ev.id %>/register" novalidate class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (waitlist) { %><input type="hidden" name="waitlist" value="1"><% } %>

      <%- include('../partials/field', { name: 'full_name', label: 'Full name', value: values.full_name || '', autocomplete: 'name', maxlength: 100 }) %>
      <%- include('../partials/field', { name: 'email', label: 'Email', type: 'email', value: values.email || '', autocomplete: 'email', inputmode: 'email', hint: 'Your ticket is sent here. You also need it to find your ticket later.' }) %>
      <%- include('../partials/field', { name: 'mobile', label: 'Mobile number', type: 'tel', value: values.mobile || '', autocomplete: 'tel-national', inputmode: 'numeric', placeholder: '09171234567', hint: '11 digits, starts with 09', maxlength: 16 }) %>

      <button class="btn btn-primary btn-big" type="submit"><%= waitlist ? 'Join waitlist' : 'Register' %></button>
    </form>
  </div>
</div>
