<% if (justRegistered) { %>
  <div class="notice notice-success ticket-notice" role="status">
    <% if (reg.status === 'waitlisted') { %>
      <strong>You're on the waitlist.</strong><% if (emailSent) { %> We sent the details to <%= reg.email %>.<% } %> We'll email you if a spot opens.
    <% } else { %>
      <strong>You're registered!</strong> Show this QR code at the door.<% if (emailSent) { %> We also emailed it to <%= reg.email %>.<% } %> To open it again later, use your ticket code and email on <a href="/tickets/find">Find my ticket</a>.
    <% } %>
  </div>
<% } %>

<article class="ticket ticket-<%= reg.status %>" aria-labelledby="ticket-title">
  <header class="ticket-head">
    <p class="eyebrow">
      <%= reg.status === 'waitlisted' ? 'Waitlist' : 'Event ticket' %>
    </p>
    <h1 id="ticket-title"><%= ev.title %></h1>
    <p class="ticket-status">
      <% if (reg.status === 'confirmed') { %><span class="badge badge-success">✓ Confirmed</span>
      <% } else if (reg.status === 'checked_in') { %><span class="badge badge-success">✓ Checked in · <%= fmt.formatTime(reg.checked_in_at) %></span>
      <% } else if (reg.status === 'waitlisted') { %><span class="badge badge-warning">On waitlist · not confirmed</span>
      <% } else { %><span class="badge badge-danger">✕ Cancelled</span><% } %>
      <% if (ev.hasEnded) { %><span class="badge badge-muted">Event ended</span><% } %>
    </p>
  </header>

  <div class="ticket-main">
    <% if (qrSvg && reg.status !== 'cancelled') { %>
      <figure class="qr">
        <div class="qr-box" role="img" aria-label="QR code for ticket <%= reg.ticket_code %>"><%- qrSvg %></div>
        <figcaption>
          <span class="ticket-code-label">Ticket code</span>
          <span class="ticket-code"><%= reg.ticket_code %></span>
        </figcaption>
      </figure>
    <% } else if (reg.status === 'waitlisted') { %>
      <div class="waitlist-box">
        <p class="waitlist-pos">You are <strong>#<%= waitlistPosition %></strong> on the waitlist</p>
        <p>This is <strong>not</strong> an entry ticket yet. If a spot opens, staff will confirm you and we'll email your QR ticket to <%= reg.email %>.</p>
        <p class="muted small">Reference code: <span class="mono"><%= reg.ticket_code %></span></p>
      </div>
    <% } else { %>
      <div class="waitlist-box">
        <p class="waitlist-pos">This registration is cancelled.</p>
        <p>It no longer works at the door.<% if (!ev.hasEnded && ev.registrationOpen) { %> You can <a href="/events/<%= ev.id %>">register again</a> if spots are available.<% } %></p>
        <p class="muted small">Reference code: <span class="mono"><%= reg.ticket_code %></span></p>
      </div>
    <% } %>

    <dl class="ticket-facts">
      <div><dt>Name</dt><dd><%= reg.full_name %></dd></div>
      <div><dt>Date</dt><dd><%= ev.dateLabel %></dd></div>
      <div><dt>Time</dt><dd><%= ev.timeLabel %></dd></div>
      <div><dt>Venue</dt><dd><%= ev.venue %></dd></div>
    </dl>
  </div>
</article>

<div class="ticket-actions">
  <% if (canCancel) { %>
    <form method="post" action="/tickets/<%= reg.ticket_code %>/cancel" data-confirm="Cancel your <%= reg.status === 'waitlisted' ? 'place on the waitlist' : 'registration' %> for <%= ev.title %>? This can't be undone.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-danger-outline" type="submit"><%= reg.status === 'waitlisted' ? 'Leave waitlist' : 'Cancel registration' %></button>
    </form>
  <% } else if (reg.status === 'checked_in') { %>
    <p class="muted small">Checked-in registrations can't be cancelled.</p>
  <% } %>
  <a class="btn btn-ghost" href="/tickets/find">Find another ticket</a>
  <a class="btn btn-ghost" href="/">Browse events</a>
</div>
