<section class="event-hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 id="hero-title">Meet Cebu’s <em>tech community.</em></h1>
    <p>Find free meetups, talks, and hackathons. Register online and bring your QR ticket to the door.</p>
    <a class="btn hero-action" href="#upcoming-events">Browse events <svg class="icon" aria-hidden="true"><use href="#icon-arrow"/></svg></a>
  </div>
  <div class="hero-art" aria-hidden="true">
    <img src="/static/images/cebu-meetup.jpg" alt="" fetchpriority="high">
  </div>
</section>

<section class="event-section" id="upcoming-events" aria-labelledby="upcoming-title">
  <h2 class="event-section-title" id="upcoming-title">Upcoming events</h2>
  <% if (!events.length) { %>
    <div class="card empty-state">
      <p>No upcoming events right now. Check back soon.</p>
    </div>
  <% } else { %>
    <ul class="event-list">
      <% events.forEach((ev) => { %>
        <li><%- include('../partials/event-card', { ev }) %></li>
      <% }) %>
    </ul>
  <% } %>
</section>

<% if (pastEvents.length) { %>
  <section class="event-section" aria-labelledby="past-title">
    <h2 class="event-section-title" id="past-title">Past events</h2>
    <ul class="event-list past-event-list">
      <% pastEvents.forEach((ev) => { %>
        <li><%- include('../partials/event-card', { ev }) %></li>
      <% }) %>
    </ul>
  </section>
<% } %>
