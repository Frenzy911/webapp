<section class="page-head">
  <h1>Upcoming events</h1>
  <p class="lead">Free tech events in Cebu. Register in a minute and get a QR ticket on your phone.</p>
</section>

<% if (!events.length) { %>
  <div class="card empty-state">
    <p>No upcoming events right now. Check back soon.</p>
  </div>
<% } else { %>
  <ul class="event-list">
    <% events.forEach((ev) => { %>
      <li><%- include('../partials/event-card', { ev }) %></li>
    <% }) %>
  </ul>
<% } %>

<% if (pastEvents.length) { %>
  <h2 class="section-title">Past events</h2>
  <ul class="event-list">
    <% pastEvents.forEach((ev) => { %>
      <li><%- include('../partials/event-card', { ev }) %></li>
    <% }) %>
  </ul>
<% } %>
