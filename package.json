{
  "name": "cebu-event-checkin",
  "version": "1.0.0",
  "private": true,
  "description": "Event registration with QR ticket check-in (Cebu Dev Meetup intern activity)",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node --disable-warning=ExperimentalWarning scripts/setup.js",
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/db/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "jsqr": "^1.4.0",
    "nodemailer": "^10.6.1",
    "qrcode": "^1.5.4"
  }
