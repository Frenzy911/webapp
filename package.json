{
  "name": "cebu-event-checkin",
  "version": "2.0.0",
  "private": true,
  "description": "Event registration with QR ticket check-in (Cebu Dev Meetup intern activity). Next.js + Supabase, deployed on Vercel.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test": "tsx --env-file=.env.local --conditions=react-server --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "seed": "tsx --env-file=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "jsqr": "^1.4.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "supabase": "^3.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
