# Copy to .env (or run `npm run setup`, which does it for you). Never commit the real .env.

PORT=3000
# Public URL of the app. Used for links in ticket emails.
APP_BASE_URL=http://localhost:3000

# Long random string used to sign session cookies and ticket email links.
SESSION_SECRET=change-me-to-a-long-random-string

# SQLite database file (relative to the project folder).
DB_FILE=./data/app.db

# Load demo data automatically when the database is empty.
AUTO_SEED=true

# Demo staff passwords used by the seed script.
SEED_ORGANIZER_PASSWORD=Organizer@2026
SEED_DOOR_PASSWORD=DoorStaff@2026

# --- Email (optional) -------------------------------------------------------
# Leave SMTP_HOST empty to save emails in the app's Emails page instead of sending.
# Mailtrap sandbox example: SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=2525
# Ethereal example:         SMTP_HOST=smtp.ethereal.email       SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cebu Events <no-reply@example.com>"

# --- Deployment --------------------------------------------------------------
# NODE_ENV=production turns on secure cookies (HTTPS only).
# NODE_ENV=production
# Set when running behind a proxy/load balancer (Render, Railway, nginx) so client IPs and HTTPS are detected.
# TRUST_PROXY=1
