# Copy to .env.local for local development. On Vercel, add the same names under
# Project → Settings → Environment Variables. Never commit real values.

# --- Supabase ---------------------------------------------------------------
# Local: `npx supabase status` prints these. Hosted: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret (service_role) key: server-only, full database access. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# --- App ----------------------------------------------------------------------
# Long random string that signs ticket email links and the "tickets on this browser" cookie.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TICKET_SECRET=change-me-to-a-long-random-string
# Public URL, used in email links. On Vercel it defaults to your production domain if left empty.
APP_BASE_URL=http://localhost:3000

# --- Email (optional) -----------------------------------------------------------
# Leave SMTP_HOST empty to only save emails on the staff Emails page.
# Local Supabase includes Mailpit: SMTP_HOST=127.0.0.1 SMTP_PORT=54325, inbox at http://127.0.0.1:54324
# Hosted examples: Resend (smtp.resend.com, 465, secure, user "resend", pass = API key), Brevo, Mailtrap sandbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cebu Events <no-reply@example.com>"

# --- Demo data (npm run seed) -------------------------------------------------
SEED_ORGANIZER_EMAIL=organizer@example.com
SEED_ORGANIZER_PASSWORD=Organizer@2026
SEED_DOOR_EMAIL=door@example.com
SEED_DOOR_PASSWORD=DoorStaff@2026
